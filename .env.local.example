# Firebase web config — copy to .env.local and fill from the Firebase console
# (Project settings → Your apps → Web app → SDK setup and configuration).
# Without these, the app runs in guest mode (orders saved to localStorage).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Realtime Database URL (Build → Realtime Database). Optional — if omitted the
# app derives https://<projectId>-default-rtdb.firebaseio.com (US region only).
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Serve product images and 3D models from Firebase Storage instead of /public.
# Set to 1 after running `node scripts/upload-assets.mjs`.
NEXT_PUBLIC_ASSETS_FROM_STORAGE=0

# --- Server (Admin SDK) order layer — optional --------------------------------
# When 1, order writes go through /api/orders (trusted, server-validated) instead
# of writing to RTDB directly from the client. Requires the service account below.
NEXT_PUBLIC_USE_SERVER_ORDERS=0

# Service account (Project settings → Service accounts → Generate new private key).
# SERVER-ONLY — never prefix these with NEXT_PUBLIC. Keep FIREBASE_PRIVATE_KEY on
# one line with literal \n for newlines, wrapped in double quotes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional overrides (default to the NEXT_ values):
# FIREBASE_PROJECT_ID=
# FIREBASE_DATABASE_URL=

# Shared secret for the one-off catalog seed route (POST /api/admin/seed).
ADMIN_SEED_SECRET=

# Comma-separated emails allowed into the /admin panel.
ADMIN_EMAILS=you@example.com
